{
  "manifest_version": 3,
  "name": "Google Flights Matrix Capture",
  "version": "0.1.0",
  "description": "Captura respostas GetCalendarGrid do Google Flights para inspeção local.",
  "permissions": ["downloads"],
  "host_permissions": ["https://www.google.com/travel/flights/*"],
  "content_scripts": [{
    "matches": ["https://www.google.com/travel/flights/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["page-hook.js", "template.xlsx"],
    "matches": ["https://www.google.com/*"]
  }]
}
